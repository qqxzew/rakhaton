# Copy to .env (git-ignored) and fill in values. Never commit real values.
API_KEY=
LLM_BASE_URL=https://apim-rakathon-q7146n.azure-api.net/openai/v1/
LLM_MODEL_EXTRACT=gpt-6-1-sol-dz-eu
LLM_MODEL_FAST=gpt-6-luna-dz-eu
# iris (default, InterSystems IRIS for Health FHIR server) or local (read dataset bundles from DATA_DIR)
FHIR_BACKEND=iris
IRIS_FHIR_BASE=http://localhost:52773/fhir/r4
IRIS_USER=SuperUser
IRIS_PASSWORD=SYS
# App state in IRIS SQL (sqlalchemy-iris). Use sqlite:///data/app.db to run without IRIS.
APP_DB_URL=iris://SuperUser:SYS@localhost:1972/FHIRSERVER
# Where the system checks image availability. Leave empty for the default: dicom with FHIR_BACKEND=iris
# (study-level C-FIND against the simulated PACS = four Orthanc containers, with a per-item fallback to the
# hospital FHIR endpoints / dataset flag when a PACS does not answer), dataset_flag otherwise.
# Other values: fhir_hospitals (search the simulated hospital FHIR endpoints only), dataset_flag (Motol PACS flag only).
AVAILABILITY_ADAPTER=
# C-FIND client for the dicom adapter: iris (IRIS production PACSDICOM, default) or pynetdicom (fallback from Python)
DICOM_CLIENT=iris
DEMO_TODAY=
SMTP_HOST=localhost
SMTP_PORT=1025
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DATA_DIR=data
